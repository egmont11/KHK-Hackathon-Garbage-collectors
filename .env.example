# Doména serveru -> automatické HTTPS (nutné pro GPS a instalaci PWA na telefonech).
# Bez domény nech :80 (jen HTTP, vhodné lokálně).
SITE_ADDRESS=:80
# SITE_ADDRESS=krajanek.example.cz

POSTGRES_PASSWORD=zmen-me

# Zabírání místa v sekundách (ostrá hra 60, demo 10)
CHECKIN_SECONDS=10

# Přihlášení do dashboardu kraje (/dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_MUST_CHANGE=0
