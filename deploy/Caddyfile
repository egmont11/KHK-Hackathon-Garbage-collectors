# Caddy uvnitř kontejneru poslouchá jen HTTP na :80; ven se mapuje přes PORT v docker-compose.yml.
# HTTPS (nutné pro GPS a PWA na telefonech) zajišťuje proxy před serverem (Coolify apod.).
:80 {
	encode zstd gzip

	@backend path /api/* /dashboard /dashboard/* /vendor/* /health
	handle @backend {
		reverse_proxy backend:3001
	}

	handle {
		root * /srv
		@fresh path /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
